# Copie para .env (ignorado pelo git) e troque os valores. Sem .env, o compose usa padrões de desenvolvimento.
DB_USERNAME=ticket
DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
RABBITMQ_USERNAME=ticket
RABBITMQ_PASSWORD=change-me

# Exigido no header X-Admin-Token para criar eventos. Vazio na aplicação = criação de eventos desligada.
ADMIN_TOKEN=change-me-to-a-long-random-value

# Estratégia de reserva: pessimistic | optimistic | conditional | redis
STRATEGY=pessimistic

# Escala horizontal: réplicas do app e conexões por réplica (réplicas x pool <= ~90)
APP_REPLICAS=3
DB_POOL_SIZE=10
APP_MEMORY=1g

# Fila virtual: com ela ligada, reservar exige o passe de quem foi admitido. Segredo HMAC com 32+ bytes.
QUEUE_ENABLED=false
QUEUE_ADMISSIONS_PER_SECOND=100
QUEUE_PASS_SECRET=change-me-to-a-long-random-value-with-32-bytes
# Limite de requisições de escrita por usuário e por IP (429 + Retry-After)
RATE_LIMIT_ENABLED=true

# Grafana (perfil observability)
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=change-me
