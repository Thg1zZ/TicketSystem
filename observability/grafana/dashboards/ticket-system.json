          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 18,
      "type": "row",
      "title": "Mapa de assentos (leitura em escala)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Leituras do mapa × consultas ao banco (/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Cache de 500 ms com single-flight: milhares de leituras viram ~2 consultas por segundo por réplica. 304 = o cliente já tinha o mapa (ETag).",
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{uri=\"/events/{eventId}/seats\"}[$__rate_interval]))",
          "legendFormat": "leituras HTTP {{status}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(seatmap_loads_total[$__rate_interval]))",
          "legendFormat": "consultas ao banco"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Conexões SSE abertas",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Mapas ao vivo por réplica. Acima do limite (ticket.seat-map.max-streams) a réplica responde 503 e a página volta ao polling.",
      "gridPos": {
        "x": 16,
        "y": 49,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance) (seatmap_streams)",
